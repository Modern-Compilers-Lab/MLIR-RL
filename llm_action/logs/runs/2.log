('from llm_action.src.actions.base import ActionBase\n'
 'from llm_action.src.utils.transformation import run_transform_code\n'
 'import re\n'
 '\n'
 'class LoopInterchange(ActionBase):\n'
 '    """\n'
 '    Loop Interchange Action:\n'
 '    Permutes the iteration order of loops in a structured operation '
 '(linalg.matmul,\n'
 '    linalg.conv_2d_*, linalg.generic, etc.) to improve memory access '
 'patterns.\n'
 '    \n'
 '    The transformation works by:\n'
 '    1. Tiling the operation to expose explicit scf.for loops.\n'
 '    2. Applying loop permutation via the `interchange` parameter of '
 '`tile_using_for`.\n'
 '    \n'
 '    The target operation is identified by the tag `operation_0`.\n'
 '    """\n'
 '\n'
 '    @classmethod\n'
 '    def parameters(cls) -> dict:\n'
 '        return {\n'
 '            "loop_indices": {\n'
 '                "type": "list[int]",\n'
 '                "description": "Permutation of loop indices (e.g., [1, 0, 2] '
 'swaps first two loops)",\n'
 '                "default": None,\n'
 '            },\n'
 '            "tile_sizes": {\n'
 '                "type": "list[int]",\n'
 '                "description": "Tile sizes for each loop. Defaults to all 1s '
 'if not provided.",\n'
 '                "default": None,\n'
 '            },\n'
 '        }\n'
 '\n'
 '    @classmethod\n'
 '    def precondition(cls, code: str, params: dict) -> bool:\n'
 '        """\n'
 '        Check if the action is applicable:\n'
 "        - Operation tagged with 'operation_0' exists.\n"
 '        - loop_indices is a valid permutation.\n'
 '        - loop_indices is not the identity permutation.\n'
 '        """\n'
 '        # Check for tagged operation\n'
 '        if \'tag = "operation_0"\' not in code:\n'
 '            return False\n'
 '\n'
 '        loop_indices = params.get("loop_indices")\n'
 '        if loop_indices is None or not isinstance(loop_indices, list):\n'
 '            return False\n'
 '\n'
 '        # Validate permutation: all indices unique, in range [0, len-1)\n'
 '        n = len(loop_indices)\n'
 '        if n == 0:\n'
 '            return False\n'
 '        if sorted(loop_indices) != list(range(n)):\n'
 '            return False\n'
 '\n'
 '        # Reject identity permutation (no-op)\n'
 '        if loop_indices == list(range(n)):\n'
 '            return False\n'
 '\n'
 '        return True\n'
 '\n'
 '    @classmethod\n'
 '    def preprocess(cls, code: str, params: dict) -> str:\n'
 '        """\n'
 '        No preprocessing needed; the transform dialect handles everything.\n'
 '        """\n'
 '        return code\n'
 '\n'
 '    @classmethod\n'
 '    def implement(cls, code: str, params: dict) -> str:\n'
 '        """\n'
 '        Apply loop interchange via structured.tile_using_for with '
 'interchange parameter.\n'
 '        \n'
 '        Strategy:\n'
 '        1. Infer the rank of the operation from the loop_indices.\n'
 '        2. If tile_sizes not provided, default to all 1s.\n'
 '        3. Construct a transform dialect snippet that:\n'
 '           - Matches operation_0.\n'
 '           - Tiles it with the given sizes and permutation.\n'
 '        4. Execute the transform.\n'
 '        """\n'
 '        loop_indices = params.get("loop_indices")\n'
 '        tile_sizes = params.get("tile_sizes")\n'
 '        \n'
 '        rank = len(loop_indices)\n'
 '        \n'
 '        # Default tile sizes to all 1s if not provided\n'
 '        if tile_sizes is None:\n'
 '            tile_sizes = [1] * rank\n'
 '        \n'
 '        # Ensure tile_sizes has correct length\n'
 '        if len(tile_sizes) != rank:\n'
 '            tile_sizes = tile_sizes[:rank] + [1] * max(0, rank - '
 'len(tile_sizes))\n'
 '        \n'
 '        # Construct the transform code\n'
 '        # Format the tile_sizes and interchange arrays for MLIR\n'
 '        tile_sizes_str = "[" + ", ".join(map(str, tile_sizes)) + "]"\n'
 '        loop_indices_str = "[" + ", ".join(map(str, loop_indices)) + "]"\n'
 '        num_loops = sum(1 for s in tile_sizes if s != 0)\n'
 '        \n'
 '        # Generate loop results syntax\n'
 '        if num_loops == 0:\n'
 '            num_loops = rank\n'
 '        loop_results = ", ".join(["!transform.any_op"] * num_loops)\n'
 '        \n'
 '        transform_code = (\n'
 '            f"module attributes {{transform.with_named_sequence}} {{\\n"\n'
 '            f"  transform.named_sequence @__transform_main(%arg1: '
 '!transform.any_op {{transform.readonly}}) {{\\n"\n'
 '            f"    %op = transform.structured.match attributes{{tag = '
 '\\"operation_0\\"}} in %arg1 : (!transform.any_op) -> !transform.any_op\\n"\n'
 '            f"    %tiled, %loops:{num_loops} = '
 'transform.structured.tile_using_for %op tile_sizes {tile_sizes_str} '
