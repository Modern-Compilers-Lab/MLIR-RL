('from llm_action.src.actions.base import ActionBase\n'
 'from llm_action.src.utils.transformation import run_transform_code\n'
 'import re\n'
 '\n'
 '\n'
 'class Tiling(ActionBase):\n'
 '    """\n'
 '    Tiling action: Decompose loop nests into nested tile loops.\n'
 '    \n'
 '    This action applies multi-level tiling to improve cache locality by '
 'reducing\n'
 '    the working set that must fit in L1/L2 cache. It targets the operation '
 'tagged\n'
 '    with \'tag = "operation_0"\' and tiles its iteration space with '
 'user-specified\n'
 '    tile sizes.\n'
 '    """\n'
 '\n'
 '    @classmethod\n'
 '    def parameters(cls) -> dict:\n'
 '        """\n'
 '        Define action parameters.\n'
 '        \n'
 '        Returns:\n'
 '            dict: Parameter specifications with defaults.\n'
 '                - tile_sizes (list[int]): Per-loop tile dimensions (0 = no '
 'tile).\n'
 '        """\n'
 '        return {\n'
 '            "tile_sizes": {\n'
 '                "type": "list[int]",\n'
 '                "description": "Tile sizes for each loop dimension. 0 = skip '
 'tiling on that dimension.",\n'
 '                "default": [32, 32, 32],  # Common L1-cache-friendly default '
 'for 3D loops\n'
 '            }\n'
 '        }\n'
 '\n'
 '    @classmethod\n'
 '    def precondition(cls, code: str, params: dict) -> bool:\n'
 '        """\n'
 '        Check if tiling is applicable.\n'
 '        \n'
 '        Verifies:\n'
 '        1. The target operation (tag = "operation_0") exists in the code.\n'
 '        2. tile_sizes is a valid non-empty list.\n'
 '        3. At least one tile size is non-zero (not a no-op).\n'
 '        \n'
 '        Args:\n'
 '            code (str): Input MLIR code.\n'
 '            params (dict): Action parameters.\n'
 '        \n'
 '        Returns:\n'
 '            bool: True if preconditions are met, False otherwise.\n'
 '        """\n'
 '        # Check that tag "operation_0" exists\n'
 '        if \'tag = "operation_0"\' not in code:\n'
 '            return False\n'
 '        \n'
 '        # Validate tile_sizes parameter\n'
 '        tile_sizes = params.get("tile_sizes", [])\n'
 '        if not isinstance(tile_sizes, (list, tuple)):\n'
 '            return False\n'
 '        \n'
 '        if len(tile_sizes) == 0:\n'
 '            return False\n'
 '        \n'
 '        # Require at least one non-zero tile size (avoid no-op)\n'
 '        if all(s == 0 for s in tile_sizes):\n'
 '            return False\n'
 '        \n'
 '        # Ensure all tile sizes are integers >= 0\n'
 '        try:\n'
 '            if not all(isinstance(s, int) and s >= 0 for s in tile_sizes):\n'
 '                return False\n'
 '        except TypeError:\n'
 '            return False\n'
 '        \n'
 '        return True\n'
 '\n'
 '    @classmethod\n'
 '    def preprocess(cls, code: str, params: dict) -> str:\n'
 '        """\n'
 '        Optional preprocessing (canonicalization).\n'
 '        \n'
 '        Currently a no-op; no preprocessing is required for tiling.\n'
 '        \n'
 '        Args:\n'
 '            code (str): Input MLIR code.\n'
 '            params (dict): Action parameters.\n'
 '        \n'
 '        Returns:\n'
 '            str: Preprocessed code (identity in this case).\n'
 '        """\n'
 '        return code\n'
 '\n'
 '    @classmethod\n'
 '    def implement(cls, code: str, params: dict) -> str:\n'
 '        """\n'
 '        Apply the tiling transformation.\n'
 '        \n'
 '        Constructs a Transform dialect snippet that:\n'
 '        1. Matches the operation with tag "operation_0".\n'
 '        2. Applies tile_using_for with the provided tile_sizes.\n'
 '        3. Executes the transform.\n'
 '        \n'
 '        Args:\n'
 '            code (str): Input MLIR code.\n'
 '            params (dict): Action parameters.\n'
 '        \n'
 '        Returns:\n'
 '            str: Transformed MLIR code, or original code if transform '
 'fails.\n'
 '        """\n'
 '        tile_sizes = params.get("tile_sizes", [])\n'
 '        \n'
 '        # Count non-zero tile sizes to determine number of output loops\n'
 '        num_loops = len(tile_sizes)\n'
 '        \n'
 '        # Build the loop result tuple: (tiled_op, loop1, loop2, ..., loopN)\n'
 '        loop_vars = ", ".join([f"%loop_{i}" for i in range(num_loops)])\n'
 '        loop_types = ", ".join(["!transform.any_op"] * num_loops)\n'
 '        \n'
 '        # Build the transform module\n'
 '        transform_code = (\n'
 '            f"module attributes {{transform.with_named_sequence}} {{\\n"\n'
 '            f"  transform.named_sequence @__transform_main(%arg1: '
 '!transform.any_op {{transform.readonly}}) {{\\n"\n'
 "            f'    %op_0 = transform.structured.match attributes{{tag = "
 '"operation_0"}} in %arg1 : (!transform.any_op) -> !transform.any_op\\n\'\n'
 '            f"    %tiled_op_0, {loop_vars} = '
 'transform.structured.tile_using_for %op_0 tile_sizes {tile_sizes} : '
 '(!transform.any_op) -> (!transform.any_op, {loop_types})\\n"\n'
 '            f"    transform.yield\\n"\n'
 '            f"  }}\\n"\n'
 '            f"}}\\n"\n'
 '        )\n'
 '        \n'
 '        try:\n'
 '            transformed_code = run_transform_code(code, transform_code)\n'
 '            return transformed_code\n'
 '        except Exception:\n'
 '            # On transform failure, return original code\n'
 '            # (postcondition will reject it as a no-op)\n'
 '            return code\n'
 '\n'
 '    @classmethod\n'
 '    def postcondition(cls, before: str, after: str, params: dict) -> bool:\n'
 '        """\n'
 '        Verify that the transformation succeeded.\n'
 '        \n'
 '        Checks:\n'
 '        1. The IR has been modified (not a no-op).\n'
 '        2. The IR is still valid (non-empty, contains func.func).\n'
 '        \n'
 '        Args:\n'
 '            before (str): Original MLIR code.\n'
 '            after (str): Transformed MLIR code.\n'
 '            params (dict): Action parameters.\n'
 '        \n'
 '        Returns:\n'
 '            bool: True if transformation succeeded, False otherwise (no-op '
 'or invalid).\n'
 '        """\n'
 '        # Reject no-ops: IR must have changed\n'
 '        if before.strip() == after.strip():\n'
 '            return False\n'
 '        \n'
 '        # Minimal sanity check: IR should not be empty\n'
 '        if not after or not after.strip():\n'
 '            return False\n'
 '        \n'
 '        # Sanity: should still contain func.func (structure preserved)\n'
 '        if "func.func" not in after:\n'
 '            return False\n'
 '        \n'
 '        return True')
