('class Action(ActionBase):\n'
 '    @classmethod\n'
 '    def parameters(cls) -> dict:\n'
 '        """\n'
 '        Define tunable parameters for loop interchange.\n'
 '        \n'
 '        Returns:\n'
 '            dict: Parameter schema with names, types, and descriptions.\n'
 '        """\n'
 '        return {\n'
 '            "loop_band": {\n'
 '                "type": "str",\n'
 '                "description": "Identifier for the loop band to interchange '
 '(e.g., \'matmul_loops\', \'conv_loops\')",\n'
 '                "default": "root"\n'
 '            },\n'
 '            "permutation": {\n'
 '                "type": "list[int]",\n'
 '                "description": "Permutation of loop indices. E.g., [1, 0, 2] '
 'swaps first two loops.",\n'
 '                "default": None\n'
 '            }\n'
 '        }\n'
 '\n'
 '    @classmethod\n'
 '    def precondition(cls, code: str, params: dict) -> bool:\n'
 '        """\n'
 '        Check if loop interchange is applicable.\n'
 '        \n'
 '        The precondition verifies:\n'
 '        1. The code contains linalg operations (matmul or conv_2d).\n'
 '        2. A permutation parameter is provided and is non-trivial.\n'
 '        3. The permutation is a valid reordering (no repeated indices, all '
 'indices in range).\n'
 '        \n'
 '        Args:\n'
 '            code (str): The MLIR code.\n'
 "            params (dict): Parameters including 'permutation' and optionally "
 "'loop_band'.\n"
 '        \n'
 '        Returns:\n'
 '            bool: True if the transformation can be applied, False '
 'otherwise.\n'
 '        """\n'
 '        # Check for linalg operations\n'
 '        if "linalg.matmul" not in code and "linalg.conv_2d_nchw_fchw" not in '
 'code:\n'
 '            return False\n'
 '        \n'
 '        permutation = params.get("permutation", None)\n'
 '        if permutation is None:\n'
 '            return False\n'
 '        \n'
 '        # Validate permutation structure\n'
 '        if not isinstance(permutation, list):\n'
 '            return False\n'
 '        \n'
 '        if len(permutation) == 0:\n'
 '            return False\n'
 '        \n'
 '        # Check that permutation is a valid reordering\n'
 '        # (all elements are unique integers within range)\n'
 '        if len(set(permutation)) != len(permutation):\n'
 '            return False  # Duplicates\n'
 '        \n'
 '        if any(not isinstance(i, int) or i < 0 or i >= len(permutation) for '
 'i in permutation):\n'
 '            return False  # Out of range\n'
 '        \n'
 '        # Permutation must be non-trivial (not identity)\n'
 '        if permutation == list(range(len(permutation))):\n'
 '            return False  # Identity permutation, no-op\n'
 '        \n'
 '        return True\n'
 '\n'
 '    @classmethod\n'
 '    def preprocess(cls, code: str, params: dict) -> str:\n'
 '        """\n'
 '        Preprocess the code if necessary.\n'
