 '\n'
 '        # Check for vector operations introduced by vectorization\n'
 '        vector_indicators = [\n'
 '            "vector.transfer_read",\n'
 '            "vector.transfer_write",\n'
 '            "vector.extract_strided_slice",\n'
 '            "vector.insert_strided_slice",\n'
 '            "arith.mulf",  # May appear in vector form\n'
 '        ]\n'
 '\n'
 '        has_vector_op = any(op in after for op in vector_indicators)\n'
 '\n'
 '        # Alternatively, check that the structure is preserved\n'
 '        # (at least some form of tensor or scf operations remain)\n'
 '        has_structure = ("tensor<" in after or "scf." in after or \n'
 '                        "linalg." in after or "vector." in after)\n'
