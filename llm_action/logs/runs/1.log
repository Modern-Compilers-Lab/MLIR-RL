 '                "description": "Tag attribute identifying target '
 'operation",\n'
 '                "type": "string",\n'
 '                "default": "matmul"\n'
 '            },\n'
 '            "loop_depth": {\n'
 '                "description": "Loop nesting depth to parallelize '
 '(0=outermost)",\n'
 '                "type": "int",\n'
 '                "default": 0,\n'
 '                "min": 0,\n'
 '                "max": 2\n'
 '            },\n'
 '            "num_threads": {\n'
 '                "description": "Number of threads (0=system default, max '
 '28)",\n'
 '                "type": "int",\n'
 '                "default": 0,\n'
 '                "min": 0,\n'
 '                "max": 28\n'
 '            }\n'
 '        }\n'
 '    \n'
 '    @classmethod\n'
 '    def precondition(cls, code: str, params: dict) -> bool:\n'
 '        """\n'
 '        Check if parallelization can be applied.\n'
 '        \n'
 '        Preconditions:\n'
 '        - Code contains a linalg operation (matmul, conv_2d, etc.)\n'
 '        - Target operation is marked with the specified tag\n'
 '        - Code contains at least loop_depth + 1 loop levels after lowering\n'
 '        """\n'
 '        operation_tag = params.get("operation_tag", "matmul")\n'
 '        \n'
 '        # Check if code contains linalg operations\n'
 '        if "linalg." not in code:\n'
 '            return False\n'
 '        \n'
 '        # Check if code contains any scf.for loops (needed for '
 'parallelization)\n'
 '        # After lowering, linalg ops are converted to loop nests\n'
 '        if "scf.for" not in code and "affine.for" not in code:\n'
 '            # May not be lowered yet; still potentially valid for transform '
 'application\n'
 '            pass\n'
