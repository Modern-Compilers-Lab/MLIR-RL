 '\n'
 'def _build_matmul_lowering_transform(enable_iterator_semantics: bool) -> '
 'str:\n'
 '    """\n'
 '    Build MLIR Transform dialect code to lower linalg.matmul to scf.for '
 'loops.\n'
 '    \n'
 '    Args:\n'
 '        enable_iterator_semantics: If True, use transform with iterator type '
 'preservation.\n'
 '        \n'
 '    Returns:\n'
 '        str: Transform dialect module as MLIR text\n'
 '    """\n'
 '    if enable_iterator_semantics:\n'
 '        # Use structured lowering with iterator type preservation\n'
 '        transform_code = """\n'
 'module attributes {transform.with_named_sequence} {\n'
 '  transform.named_sequence @__transform_main(%arg0: !transform.any_op '
 '{transform.readonly}) {\n'
 '    %matmul = transform.structured.match ops{\\"linalg.matmul\\"} in %arg0 : '
 '(!transform.any_op) -> !transform.any_op\n'
 '    %lowered = transform.structured.lower_to_loops %matmul : '
 '(!transform.any_op) -> (!transform.any_op)\n'
 '    transform.yield\n'
 '  }\n'
 '}\n'
 '"""\n'
 '    else:\n'
 '        # Simpler lowering without semantic preservation\n'
 '        transform_code = """\n'
 'module attributes {transform.with_named_sequence} {\n'
 '  transform.named_sequence @__transform_main(%arg0: !transform.any_op '
 '{transform.readonly}) {\n'
 '    %matmul = transform.structured.match ops{\\"linalg.matmul\\"} in %arg0 : '
 '(!transform.any_op) -> !transform.any_op\n'
 '    %lowered = transform.structured.lower_to_loops %matmul : '
 '(!transform.any_op) -> (!transform.any_op)\n'
 '    transform.yield\n'
 '  }\n'
 '}\n'
 '"""\n'
 '    return transform_code\n'
 '\n'
 '\n'
 'def _build_conv2d_lowering_transform(enable_iterator_semantics: bool) -> '
 'str:\n'
 '    """\n'
 '    Build MLIR Transform dialect code to lower linalg.conv_2d_nchw_fchw to '
