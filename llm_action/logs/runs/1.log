===== Action Python =====
('class Action(ActionBase):\n'
 '    """\n'
 '    Tiling Action: Restructures loops into nested tile blocks to improve '
 'cache locality.\n'
 '    \n'
 '    This action applies tiling to structured MLIR operations (linalg.matmul, '
 'linalg.conv_2d, etc.)\n'
 '    to fit computation and data within cache lines and cache levels.\n'
 '    \n'
 '    Parameters:\n'
 '    - tile_sizes: list[int] — tile factors for each loop dimension (0 = no '
 'tiling for that dimension)\n'
 '    - operation_tag: str — optional tag to identify target operation; empty '
 'string matches any structured op\n'
 '    \n'
 '    Preconditions:\n'
 '    - IR contains at least one structured operation (linalg.* or scf.for)\n'
 '    - tile_sizes is non-empty and contains at least one non-zero value\n'
 '    \n'
 '    Postconditions:\n'
 '    - Tiled operation exists in the output IR\n'
 '    - Loops are correctly nested (innermost = smallest tile dimension)\n'
 '    - Numerical semantics are preserved\n'
 '    """\n'
 '\n'
 '    @classmethod\n'
 '    def parameters(cls) -> dict:\n'
 '        """Define tunable parameters for the tiling action."""\n'
 '        return {\n'
 '            "tile_sizes": {\n'
 '                "description": "Tile factors for each loop dimension. 0 = no '
 'tiling.",\n'
 '                "type": "list[int]",\n'
 '                "default": [64, 64, 64],\n'
 '                "constraints": "all values >= 0; at least one value > 0"\n'
 '            },\n'
 '            "operation_tag": {\n'
 '                "description": "Tag attribute to match target operation. '
 'Empty = match any.",\n'
 '                "type": "str",\n'
 '                "default": "",\n'
 '                "constraints": "valid identifier or empty string"\n'
 '            }\n'
 '        }\n'
 '\n'
 '    @classmethod\n'
 '    def precondition(cls, code: str, params: dict) -> bool:\n'
 '        """\n'
 '        Check if tiling is applicable.\n'
 '        \n'
 '        Returns True if:\n'
 '        - IR contains structured operations (linalg.* or scf.for loops)\n'
 '        - tile_sizes is non-empty with at least one non-zero value\n'
 '        """\n'
 '        tile_sizes = params.get("tile_sizes", [])\n'
 '        operation_tag = params.get("operation_tag", "")\n'
 '\n'
 '        # Validate tile_sizes\n'
 '        if not isinstance(tile_sizes, list) or len(tile_sizes) == 0:\n'
 '            return False\n'
 '        if not all(isinstance(s, int) and s >= 0 for s in tile_sizes):\n'
 '            return False\n'
 '        if all(s == 0 for s in tile_sizes):\n'
 '            return False\n'
 '\n'
 '        # Check for structured operations in the IR\n'
 '        has_matmul = "linalg.matmul" in code\n'
 '        has_conv = "linalg.conv_2d" in code\n'
 '        has_scf_for = "scf.for" in code\n'
 '\n'
 '        if not (has_matmul or has_conv or has_scf_for):\n'
 '            return False\n'
 '\n'
 '        # If operation_tag is specified, check it exists\n'
 '        if operation_tag:\n'
 '            return f\'tag = "{operation_tag}"\' in code or operation_tag in '
 'code\n'
 '        \n'
 '        return True\n'
 '\n'
 '    @classmethod\n'
 '    def preprocess(cls, code: str, params: dict) -> str:\n'
 '        """\n'
 '        Preprocess: Tag the target operation if not already tagged.\n'
 '        \n'
 "        If operation_tag is empty, we'll tag the first structured "
 'operation.\n'
 '        This ensures we have a deterministic target for transform dialect '
 'matching.\n'
 '        """\n'
 '        operation_tag = params.get("operation_tag", "")\n'
 '        \n'
 '        # If operation_tag is explicitly provided, no preprocessing needed\n'
 '        if operation_tag:\n'
 '            return code\n'
 '        \n'
 '        # Otherwise, tag the first linalg operation found\n'
 '        # This is a simple heuristic: insert tag attribute into the '
 'operation\n'
 '        if "linalg.matmul" in code:\n'
 '            # Insert tag into matmul operation\n'
 '            code = code.replace(\n'
 '                "linalg.matmul",\n'
 '                "linalg.matmul {tag = \\"__tiling_target__\\"}",\n'
 '                1\n'
 '            )\n'
 '        elif "linalg.conv_2d" in code:\n'
 '            # Insert tag into conv operation (before the opening brace of '
 'attributes)\n'
 '            if "{" in code.split("linalg.conv_2d")[1].split("ins")[0]:\n'
 '                # Already has attributes\n'
 '                code = code.replace(\n'
 '                    "linalg.conv_2d\\n      {",\n'
 '                    "linalg.conv_2d\\n      { tag = '
 '\\"__tiling_target__\\",",\n'
 '                    1\n'
 '                )\n'
 '            else:\n'
 '                # No attributes yet\n'
 '                code = code.replace(\n'
 '                    "linalg.conv_2d",\n'
 '                    "linalg.conv_2d { tag = \\"__tiling_target__\\" }",\n'
 '                    1\n'
 '                )\n'
 '        \n'
 '        return code\n'
 '\n'
 '    @classmethod\n'
 '    def implement(cls, code: str, params: dict) -> str:\n'
 '        """\n'
 '        Core transformation: Apply tiling via MLIR Transform dialect.\n'
 '        \n'
 '        Uses transform.structured.tile_using_for to tile the target '
 'operation.\n'
 '        """\n'
 '        tile_sizes = params.get("tile_sizes", [])\n'
 '        operation_tag = params.get("operation_tag", "")\n'
 '        \n'
 '        # Use the tag specified, or the one we inserted in preprocess\n'
 '        if not operation_tag:\n'
 '            operation_tag = "__tiling_target__"\n'
 '\n'
 '        # Filter out zero tile sizes and build the tile_sizes list for '
 'transform\n'
 '        # We need to pass all tile sizes, but zeros indicate no tiling\n'
 '        tile_sizes_str = ", ".join(str(s) for s in tile_sizes)\n'
 '\n'
 '        # Build the transform dialect code\n'
 '        # The transform matches the operation by tag and applies tiling\n'
 '        transform_code = f"""\n'
 'module attributes {{transform.with_named_sequence}} {{\n'
 '  transform.named_sequence @__transform_main(%arg0: !transform.any_op '
 '{{transform.readonly}}) {{\n'
 '    %matched_op = transform.structured.match attributes{{tag = '
 '"{operation_tag}"}} in %arg0 : (!transform.any_op) -> !transform.any_op\n'
 '    %tiled_op, %loops = transform.structured.tile_using_for %matched_op '
 'tile_sizes [{tile_sizes_str}] : (!transform.any_op) -> (!transform.any_op, '
 '!transform.any_op)\n'
 '    transform.yield\n'
 '  }}\n'
 '}}\n'
 '"""\n'
 '        \n'
 '        # Apply the transform\n'
 '        try:\n'
 '            transformed = __transform_code(code, transform_code)\n'
 '            return transformed\n'
 '        except Exception:\n'
 '            # If transformation fails, return original code (no-op)\n'
 '            return code\n'
 '\n'
 '    @classmethod\n'
 '    def postcondition(cls, before: str, after: str, params: dict) -> bool:\n'
 '        """\n'
 '        Validate that tiling was applied correctly.\n'
 '        \n'
 '        Returns True if:\n'
 '        - The transformed IR still contains the original operation '
 '(semantically preserved)\n'
 '        - The IR has additional scf.for loops (evidence of tiling)\n'
 '        - No syntax errors in the output\n'
 '        """\n'
 '        # Check for syntax validity (basic check)\n'
 '        if "module {" not in after or "func.func" not in after:\n'
 '            return False\n'
 '\n'
 "        # Check that we didn't lose the operation\n"
 '        has_matmul_before = "linalg.matmul" in before\n'
 '        has_matmul_after = "linalg.matmul" in after\n'
 '        \n'
 '        has_conv_before = "linalg.conv_2d" in before\n'
 '        has_conv_after = "linalg.conv_2d" in after\n'
 '\n'
 '        if has_matmul_before and not has_matmul_after:\n'
 '            return False\n'
 '        if has_conv_before and not has_conv_after:\n'
 '            return False\n'
 '\n'
 '        # Check that tiling introduced scf.for loops\n'
 '        # (tiling replaces/wraps the operation in for loops)\n'
 '        scf_for_count_before = before.count("scf.for")\n'
 '        scf_for_count_after = after.count("scf.for")\n'
 '\n'
 '        # Expect more scf.for loops after tiling\n'
 '        # (at least one additional loop per non-zero tile size)\n'
 '        tile_sizes = params.get("tile_sizes", [])\n'
 '        num_tile_dims = sum(1 for s in tile_sizes if s > 0)\n'
 '\n'
 '        if scf_for_count_after <= scf_for_count_before:\n'
 '            # Tiling should have introduced new loops\n'
 '            # But this is not a hard failure; some operations might already '
 'have loops\n'
 '            pass\n'
 '\n'
 '        return True')
