('class Action(ActionBase):\n'
 '    """\n'
 '    Action: TransposeTensor\n'
 '    \n'
 '    Transposes a tensor by reordering its dimensions to align iteration and '
 'memory access order.\n'
 '    This can convert between row-major and column-major layouts, improving '
 'cache utilization\n'
 '    and vectorization efficiency.\n'
 '    \n'
 '    The action works by:\n'
 '    1. Identifying the target operand in the function signature.\n'
 '    2. Creating a memref allocation and transpose operation.\n'
 '    3. Updating dependent operations to use the transposed tensor.\n'
 '    """\n'
 '\n'
 '    @classmethod\n'
 '    def parameters(cls) -> dict:\n'
 '        return {\n'
 '            "tensor_operand": {\n'
 '                "description": "The operand name or index of the tensor to '
 'transpose.",\n'
 '                "type": "str",\n'
 '                "required": True,\n'
 '            },\n'
 '            "permutation": {\n'
 '                "description": "List of integers specifying the new '
 'dimension order.",\n'
 '                "type": "list[int]",\n'
 '                "required": True,\n'
 '            },\n'
 '            "operation_tag": {\n'
 '                "description": "Tag to mark the target operation for '
 'transformation.",\n'
 '                "type": "str",\n'
 '                "default": "linalg_op",\n'
 '            },\n'
 '        }\n'
 '\n'
 '    @classmethod\n'
 '    def precondition(cls, code: str, params: dict) -> bool:\n'
 '        """\n'
 '        Check that the transformation is applicable:\n'
 '        - The specified tensor operand exists in the function.\n'
 '        - The permutation is valid (is a list of unique integers).\n'
 '        - The tensor has a known rank (for basic validation).\n'
 '        """\n'
 '        try:\n'
 '            tensor_operand = params.get("tensor_operand")\n'
 '            permutation = params.get("permutation", [])\n'
 '            \n'
 '            if not isinstance(permutation, list):\n'
 '                return False\n'
 '            \n'
 '            if not permutation:\n'
 '                return False\n'
 '            \n'
 '            # Check for valid permutation: all unique, non-negative '
 'integers\n'
 '            if len(set(permutation)) != len(permutation):\n'
 '                return False  # Duplicates\n'
 '            \n'
 '            if any(not isinstance(p, int) or p < 0 for p in permutation):\n'
 '                return False\n'
 '            \n'
 '            # Basic check: operand name appears in the code\n'
 '            if not isinstance(tensor_operand, str):\n'
 '                return False\n'
 '            \n'
 '            if tensor_operand not in code:\n'
 '                return False\n'
 '            \n'
 '            # Check for presence of linalg operations\n'
 '            if "linalg." not in code:\n'
 '                return False\n'
 '            \n'
 '            return True\n'
 '        except Exception:\n'
 '            return False\n'
 '\n'
 '    @classmethod\n'
 '    def preprocess(cls, code: str, params: dict) -> str:\n'
 '        """\n'
 '        No preprocessing required. The code is used as-is.\n'
 '        The transform dialect will handle all necessary preparations.\n'
 '        """\n'
 '        return code\n'
 '\n'
 '    @classmethod\n'
 '    def implement(cls, code: str, params: dict) -> str:\n'
 '        """\n'
 '        Implement the transpose transformation using MLIR Transform '
 'dialect.\n'
 '        \n'
 '        The strategy:\n'
 '        1. Match the linalg operation that uses the target tensor operand.\n'
 '        2. Extract the operand and create a transposed view/copy.\n'
 '        3. Replace uses of the original tensor with the transposed tensor in '
