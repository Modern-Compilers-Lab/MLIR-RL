('from llm_action.src.actions.base import ActionBase\n'
 'from llm_action.src.utils.transformation import run_transform_code\n'
 '\n'
 '\n'
 'class Tiling(ActionBase):\n'
 '    """\n'
 '    Tiling transformation action.\n'
 '    \n'
 '    Partitions the iteration space of the target operation (tagged with '
 '"operation_0")\n'
 '    into rectangular blocks (tiles) to improve cache locality and data '
 'reuse.\n'
 '    Uses transform.structured.tile_using_for for sequential tiling on CPU.\n'
 '    """\n'
 '\n'
 '    @classmethod\n'
 '    def parameters(cls) -> dict:\n'
 '        """\n'
 '        Define the parameters for the tiling action.\n'
 '        \n'
 '        Returns:\n'
 '            dict: Parameter specification with tile_sizes.\n'
 '        """\n'
 '        return {\n'
 '            "tile_sizes": {\n'
 '                "type": "list[int]",\n'
 '                "description": "Tile sizes for each loop dimension. 0 means '
 'no tiling for that dimension.",\n'
 '                "default": None,\n'
 '            }\n'
 '        }\n'
 '\n'
 '    @classmethod\n'
 '    def precondition(cls, code: str, params: dict) -> bool:\n'
 '        """\n'
 '        Check if the action is applicable to the given IR.\n'
 '        \n'
 '        Validates:\n'
 '        - The target operation with tag "operation_0" exists\n'
 '        - tile_sizes parameter is well-formed and non-empty\n'
 '        - At least one tile size is non-zero (non-trivial tiling)\n'
 '        \n'
 '        Args:\n'
 '            code (str): MLIR IR as string.\n'
 '            params (dict): Action parameters, must contain "tile_sizes".\n'
 '        \n'
 '        Returns:\n'
 '            bool: True if action is applicable, False otherwise.\n'
 '        """\n'
 '        # Check that tag "operation_0" exists\n'
 '        if \'tag = "operation_0"\' not in code:\n'
 '            return False\n'
 '        \n'
 '        # Extract and validate tile_sizes parameter\n'
 '        if "tile_sizes" not in params:\n'
 '            return False\n'
 '        \n'
 '        tile_sizes = params.get("tile_sizes")\n'
 '        \n'
 '        # Tile sizes must be a non-empty list\n'
 '        if not isinstance(tile_sizes, list) or len(tile_sizes) == 0:\n'
 '            return False\n'
 '        \n'
 '        # All elements must be non-negative integers\n'
 '        if not all(isinstance(s, int) and s >= 0 for s in tile_sizes):\n'
 '            return False\n'
 '        \n'
 '        # At least one tile size must be non-zero (no trivial/no-op tiling)\n'
 '        if all(s == 0 for s in tile_sizes):\n'
 '            return False\n'
 '        \n'
 '        return True\n'
 '\n'
 '    @classmethod\n'
 '    def preprocess(cls, code: str, params: dict) -> str:\n'
 '        """\n'
 '        Optional preprocessing / canonicalization.\n'
 '        \n'
 '        For tiling, no preprocessing is required. Return the code as-is.\n'
 '        \n'
 '        Args:\n'
 '            code (str): MLIR IR as string.\n'
 '            params (dict): Action parameters.\n'
 '        \n'
 '        Returns:\n'
 '            str: Preprocessed (or identity) MLIR code.\n'
 '        """\n'
 '        return code\n'
 '\n'
 '    @classmethod\n'
 '    def implement(cls, code: str, params: dict) -> str:\n'
 '        """\n'
 '        Implement the tiling transformation using MLIR Transform dialect.\n'
 '        \n'
 '        Constructs a transform sequence that:\n'
 '        1. Matches the target operation via tag = "operation_0"\n'
 '        2. Applies tile_using_for with the provided tile sizes\n'
 '        \n'
 '        Args:\n'
 '            code (str): MLIR IR as string.\n'
 '            params (dict): Action parameters with tile_sizes.\n'
 '        \n'
 '        Returns:\n'
 '            str: Transformed MLIR code, or original code on failure.\n'
 '        """\n'
 '        tile_sizes = params["tile_sizes"]\n'
 '        \n'
 '        # Determine number of loops to be generated (count non-zero tile '
 'sizes)\n'
 '        num_loops = sum(1 for s in tile_sizes if s != 0)\n'
 '        \n'
 '        # Build the result type for transform.structured.tile_using_for\n'
 '        # Result is: tiled_op (1) + loops (num_loops)\n'
 '        loop_types = ", ".join(["!transform.any_op"] * num_loops)\n'
 '        result_type = f"(!transform.any_op, {loop_types})" if num_loops > 0 '
 'else "(!transform.any_op)"\n'
 '        \n'
 '        # Format tile sizes as MLIR dense array syntax\n'
 '        tile_sizes_str = ", ".join(str(s) for s in tile_sizes)\n'
